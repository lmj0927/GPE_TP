    - target: {fileID: 6631551795210650472, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: m_Name
      value: StoryUI
      objectReference: {fileID: 0}
    - target: {fileID: 6631551795210650472, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[0].text
      value: "\uD558\uC544... \uD558\uC544... \uB4DC\uB514\uC5B4 \uACE0\uC9C0\uAC00
        \uBCF4\uC778\uB2E4. \uACF5\uC8FC\uB2D8, \uC870\uAE08\uB9CC \uB354 \uAE30\uB2E4\uB9AC\uC2ED\uC2DC\uC624!
        \uC800 \uC0AC\uC545\uD55C \uB9C8\uC655\uC758 \uB300\uC758\uC2DD\uC744 \uB9C9\uC544\uB0B4\uACA0\uC2B5\uB2C8\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[1].text
      value: "(\uC544\uB2C8....\uB610 \uC0B4\uC544\uB0AC\uB2E8 \uB9D0\uC774\uC57C?)"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[2].text
      value: "\uC6A9\uC0AC\u2026\u2026\uB2D8\u2026\u2026 \uC758\uC2DD\uC774\u2026\u2026
        \uACE7\u2026\u2026 \uC644\uC131\uB3FC\uC694\u2026\u2026 \uC73C\uC73D\u2026\u2026."
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[3].text
      value: "\uB9C8\uC655! \uB124\uB188\uC758 \uCD94\uC545\uD55C \uC57C\uC695\uB3C4
        \uC5EC\uAE30\uAE4C\uC9C0\uB2E4! \uB300\uCCB4 \uBB34\uC2A8 \uBD80\uADC0\uC601\uD654\uB97C
        \uB204\uB9AC\uACA0\uB2E4\uACE0 \uC628 \uC138\uC0C1\uC744 \uD30C\uAD34\uD558\uACE0
        \uACF5\uC8FC\uB2D8\uAE4C\uC9C0 \uAD34\uB86D\uD788\uB294 \uAC70\uB0D0! \uB124\uAC00
        \uC138\uC0C1\uC744 \uBA78\uB9DD\uC2DC\uD0A4\uB824\uB294 \uC9C4\uC9DC \uC774\uC720\uAC00
        \uB300\uCCB4 \uBB50\uB0D0?!"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[4].text
      value: "\uD6E0\uD6E0\uD6E0! \uC774 \uC5B4\uB9AC\uC11D\uC740 \uC6A9\uC0AC \uB188,
        \uAC10\uD788 \uC704\uB300\uD55C \uB9C8\uC655\uC5D0\uAC8C \uADF8\uB7F0 \uBED4\uD55C
        \uC9C8\uBB38\uC744\u2026\u2026 \uC5B4?"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[5].text
      value: "(\uC7A0\uAE50\uB9CC. \uB098 \uC138\uC0C1\uC744 \uC65C \uB9DD\uCE58\uB824\uACE0
        \uD588\uC9C0? \uB531\uD788 \uC778\uAC04\uB4E4\uD55C\uD14C \uC6D0\uD55C\uC774
        \uC788\uB294 \uAC83\uB3C4 \uC544\uB2C8\uACE0... \uB3C8\uC744 \uB354 \uBC84\uB294
        \uAC83\uB3C4 \uC544\uB2CC\uB370? \uC5B4\uB77C?)"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[6].text
      value: "\uC65C \uB9D0\uC774 \uC5C6\uB0D0, \uB9C8\uC655! \uB124\uB188\uC758
        \uADF8 \uAC70\uCC3D\uD558\uACE0 \uC0AC\uC545\uD55C \uACC4\uD68D\uC744 \uB2F9\uB2F9\uD558\uAC8C
        \uB9D0\uD574\uBD10\uB77C!"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[7].text
      value: "\uC2DC, \uC2DC\uB044\uB7FD\uB2E4! \uADF8\uB0E5 \uB9C8\uC655\uC73C\uB85C
        \uD0DC\uC5B4\uB0AC\uC73C\uB2C8\uAE4C \uC138\uC0C1\uC744 \uBA78\uB9DD\uC2DC\uD0A4\uB294
        \uAC8C \uB2F9\uC5F0\uD55C \uC904 \uC54C\uC558\uB2E8 \uB9D0\uC774\uB2E4! \uB098\uB3C4
        \uB0B4\uAC00 \uC65C \uB9DD\uCE58\uACE0 \uC788\uB294\uC9C0 \uBAB0\uB77C!"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[8].text
      value: "\uBB50...???"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[9].text
      value: "\uC5D0\uB77C \uBAA8\uB974\uACA0\uB2E4! \uC790\uC7AC \uACF5\uC7A5\uC774
        \uB2E4 \uB9DD\uD574\uC11C \uC774\uC81C \uB358\uC9C8 \uC218 \uC788\uB294 \uBC29\uD574\uBB3C\uB3C4
        \uC548 \uB0A8\uC558\uB2E8 \uB9D0\uC774\uB2E4! \uC5D0\uC774\uC775, \uB3C8
        \uC5C6\uC73C\uBA74 \uBAB8\uC73C\uB85C \uB54C\uC6CC\uC57C\uC9C0! \uC8FC\uBCC0\uC5D0
        \uAD74\uB7EC\uB2E4\uB2C8\uB294 \uC131\uBCBD \uB3CC\uB9F9\uC774\uB77C\uB3C4
        \uC8C4\uB2E4 \uC5FC\uB825\uC73C\uB85C \uAE01\uC5B4\uBAA8\uC544 \uB358\uC838\uC8FC\uB9C8!"
      objectReference: {fileID: 0}
    - target: {fileID: 7984459463115591538, guid: d18fff71eba254149b20567a6c792c8f, type: 3}
      propertyPath: storyData.Array.data[10].text
      value: "\uC8FD\uC5B4\uB77C!!!!! \uC138\uC0C1\uC740 \uBA78\uB9DD\uD560 \uAC83\uC774\uB2E4!!!!!!!"
      objectReference: {fileID: 0}
